# Environment
# Use your Project URL from Dashboard → Connect, or: https://YOUR_REF.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Client key — use EITHER:
#   New: Publishable key (sb_publishable_...) from API Keys tab
#   Legacy: anon public key (eyJ...) from "Legacy anon, service_role" tab
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Supabase Edge Function secrets (set in Supabase dashboard, not in the app)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically — do not set them.
# RESEND_API_KEY=re_your_resend_key
# RESEND_FROM_EMAIL=Afterward <hello@thekshitij.com>
# APP_URL=afterward://capsule

# EAS (for push notifications)
# Set your project ID in app.json under extra.eas.projectId after running `eas init`
